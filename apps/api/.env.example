# Example only. Do not commit real secrets. Copy to apps/api/.env (git-ignored) for local development.
# The API does not read this file itself: load it into the environment before starting the API
# (see docs/DESIGN.md, "Local development"). On Railway, set these as service variables.

# Required. Gemini API key.
AI_API_KEY=
# Required. Gemini model id, e.g. a model listed at https://ai.google.dev/gemini-api/docs/models
AI_MODEL=
# Required. Gemini request timeout in whole seconds, 1-300.
AI_TIMEOUT_SECONDS=
# Comma-separated origins allowed to call the API (the deployed frontend URL). Empty = none.
CORS_ALLOWED_ORIGINS=
